# Copy values into Render's environment settings. Never commit actual secrets.
APP_ENV=production
DEMO_MODE=false
DATABASE_BACKEND=tidb
# URL-encode reserved characters in the username/password.
TIDB_DATABASE_URL=mysql+pymysql://USERNAME:URL_ENCODED_PASSWORD@HOST.tidbcloud.com:4000/pondokconnect?charset=utf8mb4
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
UPLOAD_DIR=/var/data/uploads
SERVE_FRONTEND=true
BOOTSTRAP_OWNER_EMAIL=pengelola@pondokconnect.id
GROQ_API_KEY=CHANGE_ME_PRIVATE_GROQ_KEY
GROQ_VISION_MODEL=qwen/qwen3.8-27b
OCR_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
# Render supplies RENDER_EXTERNAL_URL and PORT automatically.
# Outside Render, set PUBLIC_FRONTEND_URL=https://your-domain.example
# Optional CA file for an organization-specific certificate authority:
# DATABASE_TLS_CA=/path/to/ca-bundle.pem
