# Keep this repository limited to the website and its development/deployment files.
/*
!/.gitignore
!/.dockerignore
!/README.md
!/Dockerfile
!/compose.yaml
!/render.yaml
!/alembic.ini
!/pyproject.toml
!/.env.example
!/.env.production.example
!/backend/
!/frontend/
!/database/
!/scripts/
!/docs/
/docs/*
!/docs/API.md
!/docs/DEPLOYMENT.md

# Secrets, runtime data, dependencies and generated files are always local.
**/.env
**/.env.*
!/.env.example
!/.env.production.example
**/__pycache__/
**/*.py[cod]
**/node_modules/
**/dist/
**/.pytest_cache/
**/.ruff_cache/
**/test-results/
**/playwright-report/
**/.coverage
**/*.db
**/*.sqlite*
**/*.log
**/*.egg-info/
/frontend/tests/artifacts/
/frontend/tests/capture*.mjs
/frontend/tests/render-covers.mjs
